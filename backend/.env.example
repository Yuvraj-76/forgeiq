# CatalogAI Python Backend Environment Variables

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Demo Mode (If true or if GEMINI_API_KEY is missing, runs deterministic offline mock engine)
DEMO_MODE=false

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration (In-Memory SQLite by default, easy PostgreSQL upgrade)
DATABASE_URL=sqlite:///./catalogai.db
