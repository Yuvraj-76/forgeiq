# ==========================================
# Frontend Environment Variables (Vercel / Vite)
# Note: Vite me client-side variables ka prefix VITE_ hona zaroori hai.
# ==========================================

# Optional: External Backend API URL (agar aapne Python FastAPI backend alag se deploy kiya ho)
# Default demo mode ke liye ise blank chhod sakte hain.
VITE_API_BASE_URL=

# ==========================================
# Backend / Server-side Secrets (Optional)
# ==========================================
# GEMINI_API_KEY: Agar aap direct Gemini API call kar rahe hain backend par
GEMINI_API_KEY=
